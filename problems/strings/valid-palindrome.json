      "input": {
        "s": "A man, a plan, a canal: Panama"
      },
      "output": true,
      "explanation": "Ignoring spaces and punctuation leaves a palindrome."
    },
    {
      "input": {
        "s": "race a car"
      },
      "output": false,
      "explanation": "The normalized characters are not symmetric."
    }
  ],
